<div class="layout">
  <nav class="sidebar">
    <h1>Homey components</h1>
    <a class="nav-item" href="/preview">▸ Preview playground</a>
    <% @catalog.by_category.each do |category, components| %>
      <h3><%= category.tr('_', ' ') %></h3>
      <% components.each do |c| %>
        <button class="nav-item" data-name="<%= c.name %>" data-sizes="<%= c.sizes.join(',') %>"
                data-sample='<%= c.sample.to_json %>' data-options='<%= c.options.to_json %>'
                title="<%= c.description %>">
          <%= c.title %>
        </button>
      <% end %>
    <% end %>
  </nav>
  <main class="stage">
    <div class="toolbar">
      <span id="title"></span>
      <span id="sizes"></span>
      <button id="copy">Copy markup</button>
    </div>
    <div class="preview-wrap">
      <iframe id="preview" title="preview"></iframe>
    </div>
    <div id="controls" class="controls"></div>
    <details open>
      <summary>Sample data (edit to re-render)</summary>
      <textarea id="data" spellcheck="false"></textarea>
    </details>
    <details>
      <summary>Markup (edit to re-render)</summary>
      <textarea id="markup" spellcheck="false"></textarea>
    </details>
  </main>
</div>
<%# escape </ so a component's own <script> tags can't terminate this inline script %>
<script>window.MARKUP = <%= @catalog.components.to_h { |c| [c.name, c.markup] }.to_json.gsub("</", "<\\/") %>;</script>
