{% template trmnl_badge %}
{% assign size = size | default: "base" %}
{% assign default_style = default_style | default: "outline" %}
<div class="flex flex--row flex--wrap gap--small">
  {% for b in badges %}
  <span class="label label--{{ b.style | default: default_style }}{% if size == 'small' %} label--small{% elsif size == 'large' %} label--large{% endif %}">{{ b.text }}</span>
  {% endfor %}
</div>
{% endtemplate %}

{% template trmnl_divider %}
{% if title %}<span class="title title--small lg:title--base">{{ title }}</span>{% endif %}
<div class="divider"></div>
{% endtemplate %}

{% template trmnl_list %}
{% assign cols = columns | default: "1" %}
{% assign lg_cols = lg_columns | default: "2" %}
{% assign numbered = numbered | default: "no" %}
{% assign n = items | size %}
{% if n == 0 %}
<span class="label lg:label--large">No data</span>
{% else %}
<div class="grid grid--cols-{{ cols }} lg:grid--cols-{{ lg_cols }} gap">
  {% for item in items %}
  <div class="flex flex--row flex--between flex--center-y w--full">
    <span class="flex flex--row flex--center-y gap--small">{% if numbered == "yes" %}<span class="value value--small lg:value--large value--tnums">{{ forloop.index }}.</span>{% endif %}<span class="label lg:label--large">{{ item.label }}</span></span>
    <span class="value value--small lg:value--large value--tnums">{{ item.value }}{{ item.unit }}</span>
  </div>
  {% endfor %}
</div>
{% endif %}
{% endtemplate %}

{% template trmnl_progress %}
{% assign style = style | default: "bar" %}
{% assign size = size | default: "base" %}
<div class="flex flex--row flex--between flex--center-y w--full">
  <span class="label lg:label--large">{{ label }}</span>
  <span class="value value--small lg:value--large value--tnums">{% if style == "dots" %}{{ value }} / {{ total | default: 5 }}{% else %}{{ value }}%{% endif %}</span>
</div>
{% if style == "dots" %}
{% assign total_dots = total | default: 5 %}
<div class="progress-dots{% if size == 'small' %} progress-dots--small{% elsif size == 'large' %} progress-dots--large{% endif %}">
  <div class="track">{% for i in (1..total_dots) %}<div class="dot{% if i <= value %} dot--filled{% endif %}"></div>{% endfor %}</div>
</div>
{% else %}
{% comment %} explicit track/fill so it renders without the data-progress JS engine; fill width is the data binding the engine would set inline {% endcomment %}
<div class="progress-bar w--full{% if size == 'small' %} progress-bar--small{% elsif size == 'large' %} progress-bar--large{% endif %}">
  <div class="track"><div class="fill" style="width: {{ value }}%"></div></div>
</div>
{% endif %}
{% endtemplate %}

{% template trmnl_sparkline %}
{% assign fill = fill | default: "no" %}
{% assign show_dots = show_dots | default: "no" %}
{% comment %} Zero-JS SVG trend (Meteogramm pattern): geometry in Liquid, viewBox 320x100. {% endcomment %}
{% assign X0 = 6 %}
{% assign Y_BOT = 92 %}
{% assign PLOT_W = 308 %}
{% assign PLOT_H = 82 %}
{% assign n = series | size %}
{% if n == 0 %}
<div class="layout"><div class="item"><div class="content"><span class="label lg:label--large">No data</span></div></div></div>
{% else %}
{% comment %} scale: actual min/max for labels; bump hi when flat so range is never 0 (divide-by-zero guard). {% endcomment %}
{% assign vmax = series.first.value %}
{% assign vmin = series.first.value %}
{% for p in series %}{% if p.value > vmax %}{% assign vmax = p.value %}{% endif %}{% if p.value < vmin %}{% assign vmin = p.value %}{% endif %}{% endfor %}
{% assign lo = vmin %}
{% assign hi = vmax %}
{% if hi == lo %}{% assign hi = lo | plus: 1 %}{% endif %}
{% assign range = hi | minus: lo %}
{% comment %} x step spans n-1 gaps; guard a single point. {% endcomment %}
{% assign last_i = n | minus: 1 %}
{% if last_i < 1 %}{% assign last_i = 1 %}{% endif %}
{% assign step = PLOT_W | divided_by: last_i %}
{% assign last_x = last_i | times: step | plus: X0 %}
{% capture pts %}{% for p in series %}{% assign x = forloop.index0 | times: step | plus: X0 %}{% assign rel = p.value | minus: lo %}{% assign y = rel | times: PLOT_H | divided_by: range %}{% assign y = Y_BOT | minus: y %}{{ x }},{{ y | round: 1 }} {% endfor %}{% endcapture %}
<div class="layout layout--col gap">
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ series.last.value }}{% if unit != "" %} {{ unit }}{% endif %}</span>
      <span class="label lg:label--large">{{ title }}</span>
    </div>
  </div>
  <svg viewBox="0 0 320 100" width="100%" preserveAspectRatio="none" style="display:block;width:100%;height:120px;font-family:inherit;">
    <line x1="{{ X0 }}" y1="{{ Y_BOT }}" x2="{{ last_x }}" y2="{{ Y_BOT }}" stroke="#000" stroke-width="0.5" opacity="0.4"/>
    {% if fill == "yes" %}<polygon points="{{ X0 }},{{ Y_BOT }} {{ pts }}{{ last_x }},{{ Y_BOT }}" fill="#000" opacity="0.12"/>{% endif %}
    <polyline points="{{ pts }}" fill="none" stroke="#000" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
    {% if show_dots == "yes" %}{% for p in series %}{% assign x = forloop.index0 | times: step | plus: X0 %}{% assign rel = p.value | minus: lo %}{% assign y = rel | times: PLOT_H | divided_by: range %}{% assign y = Y_BOT | minus: y %}<circle cx="{{ x }}" cy="{{ y | round: 1 }}" r="2" fill="#000"/>{% endfor %}{% endif %}
    <text x="{{ X0 }}" y="10" style="font-size:9px;font-family:Helvetica,Arial,sans-serif;" opacity="0.55">{{ vmax }}{{ unit }}</text>
    <text x="{{ last_x }}" y="90" text-anchor="end" style="font-size:9px;font-family:Helvetica,Arial,sans-serif;" opacity="0.55">{{ vmin }}{{ unit }}</text>
  </svg>
</div>
<div class="title_bar">
  <span class="title lg:title--large">{{ title }}</span>
  <span class="instance">Trend</span>
</div>
{% endif %}
{% endtemplate %}

{% template trmnl_stat %}
{% assign size = size | default: "xxlarge" %}
{% assign lg_size = lg_size | default: "giga" %}
{% assign color_delta = color_delta | default: "no" %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="value value--{{ size }} lg:value--{{ lg_size }} value--tnums" data-fit-value="true">{{ value }}{{ unit }}</span>
    <div class="flex flex--row flex--center-y gap--small">
      <span class="label lg:label--large">{{ label }}</span>
      {% if delta %}
      {% assign tone = "" %}
      {% if color_delta == "yes" %}{% if delta_dir == "down" %}{% assign tone = "text--error" %}{% else %}{% assign tone = "text--success" %}{% endif %}{% endif %}
      <span class="flex flex--row flex--center-y gap--xsmall {{ tone }}">
        <svg width="9" height="9" viewBox="0 0 10 10" aria-hidden="true">{% if delta_dir == "down" %}<path d="M1,3 L9,3 L5,9 Z" fill="currentColor"/>{% else %}<path d="M5,1 L9,7 L1,7 Z" fill="currentColor"/>{% endif %}</svg>
        <span class="label lg:label--large">{{ delta }}</span>
      </span>
      {% endif %}
    </div>
  </div>
</div>
{% endtemplate %}

{% template trmnl_table %}
{% assign size = size | default: "small" %}
{% assign lg_size = lg_size | default: "base" %}
{% assign limit = limit | default: "yes" %}
<table class="table table--{{ size }} lg:table--{{ lg_size }}"{% if limit == "yes" %} data-table-limit="true"{% endif %}>
  <thead>
    <tr>{% for col in columns %}<th><span class="title title--small lg:title--base">{{ col }}</span></th>{% endfor %}</tr>
  </thead>
  <tbody>
    {% for row in rows %}
    <tr>{% for cell in row %}{% assign a = align[forloop.index0] | default: "left" %}<td>{% if a == "right" %}<span class="value value--xxsmall lg:value--small value--tnums">{{ cell }}</span>{% else %}<span class="label lg:label--large">{{ cell }}</span>{% endif %}</td>{% endfor %}</tr>
    {% endfor %}
  </tbody>
</table>
{% endtemplate %}

{% template trmnl_text %}
{% assign clamp = clamp | default: "4" %}
{% assign align = align | default: "left" %}
{% if title %}<span class="title title--small lg:title--base">{{ title }}</span>{% endif %}
<div class="richtext richtext--{{ align }}">
  <div class="content content--base" data-clamp="{{ clamp }}">{{ body }}</div>
</div>
{% endtemplate %}

{% template trmnl_chart_area %}{% render "trmnl_chart", data: data, chart_type: "area", curve: "yes" %}{% endtemplate %}

{% template trmnl_chart_bar %}{% render "trmnl_chart", data: data, chart_type: "bar" %}{% endtemplate %}

{% template trmnl_chart %}
{% assign chart_type = chart_type | default: "line" %}
{% assign color_scheme = color_scheme | default: "black" %}
{% assign curve = curve | default: "no" %}
{% assign points = points | default: "no" %}
{% assign legend = legend | default: "none" %}
{% assign stacked = stacked | default: "no" %}
{% assign data_labels = data_labels | default: "no" %}
{% assign gridlines = gridlines | default: "dotted" %}
{% assign modules = modules | default: "no" %}
{% assign library = library | default: "{}" %}
{% assign chart_id = "homey-chart" | append_random %}
{% if color_scheme == "grey" %}{% assign colors = '["#888888"]' %}{% elsif color_scheme == "black+grey" %}{% assign colors = '["#000000","#888888"]' %}{% else %}{% assign colors = '["#000000"]' %}{% endif %}
{% if gridlines == "solid" %}{% assign dash = "Solid" %}{% assign gw = 1 %}{% elsif gridlines == "none" %}{% assign dash = "Solid" %}{% assign gw = 0 %}{% else %}{% assign dash = "Dot" %}{% assign gw = 1 %}{% endif %}
{% if legend == "none" %}{% assign legend_js = "false" %}{% else %}{% assign legend_js = legend | prepend: '"' | append: '"' %}{% endif %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/chartkick/5.0.1/chartkick.min.js"></script>
{% if modules == "yes" %}<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts-more.js"></script>
<script src="https://trmnl.com/js/highcharts/12.3.0/pattern-fill.js"></script>{% endif %}
<div class="layout layout--col">
  <div id="{{ chart_id }}" style="width:100%;flex-grow:1;min-height:0;"></div>
</div>
<script>
  (function () {
    var data = {{ data | json }};
    var eink = {
      chart: { backgroundColor: "transparent", style: { fontFamily: "inherit" } },
      plotOptions: { series: { animation: false, borderWidth: 0, lineWidth: 3, marker: { enabled: {% if points == "yes" %}true{% else %}false{% endif %} }, dataLabels: { enabled: {% if data_labels == "yes" %}true{% else %}false{% endif %} } } },
      credits: { enabled: false },
      tooltip: { enabled: false },
      yAxis: { gridLineColor: "#000000", gridLineDashStyle: "{{ dash }}", gridLineWidth: {{ gw }}, title: { text: null }, labels: { style: { color: "#000000", fontSize: "14px" } } },
      xAxis: { lineColor: "#000000", labels: { style: { color: "#000000", fontSize: "14px" } } }
    };
    var raw = {};
    var rawStr = {{ library | json }};
    try { raw = rawStr ? JSON.parse(rawStr) : {}; } catch (e) {}
    function deepMerge(a, b) {
      for (var k in b) {
        if (b[k] && typeof b[k] === "object" && !Array.isArray(b[k]) && a[k] && typeof a[k] === "object") { deepMerge(a[k], b[k]); }
        else { a[k] = b[k]; }
      }
      return a;
    }
    var opts = {
      colors: {{ colors }},
      curve: {% if curve == "yes" %}true{% else %}false{% endif %},
      points: {% if points == "yes" %}true{% else %}false{% endif %},
      legend: {{ legend_js }},
      stacked: {% if stacked == "yes" %}true{% else %}false{% endif %},
      library: deepMerge(eink, raw)
    };
    var make = function () { new Chartkick["{{ chart_type | capitalize }}Chart"]("{{ chart_id }}", data, opts); };
    if ("Chartkick" in window) { make(); } else { window.addEventListener("chartkick:load", make, true); }
  })();
</script>
{% endtemplate %}

{% template trmnl_chart_column %}{% render "trmnl_chart", data: data, chart_type: "column" %}{% endtemplate %}

{% template trmnl_chart_combo %}{% render "trmnl_chart", data: data, legend: "bottom" %}{% endtemplate %}

{% template trmnl_chart_donut %}{% render "trmnl_chart", data: data, chart_type: "pie", library: '{"plotOptions":{"pie":{"innerSize":"60%"}},"colors":["#000000","#606060","#a0a0a0","#d0d0d0"]}' %}{% endtemplate %}

{% template trmnl_chart_line %}{% render "trmnl_chart", data: data %}{% endtemplate %}

{% template trmnl_chart_pattern_area %}{% render "trmnl_chart", data: data, chart_type: "area", modules: "yes", library: '{"plotOptions":{"series":{"fillOpacity":1,"fillColor":{"pattern":{"path":{"d":"M 0 0 L 6 6 M -1 5 L 1 7 M 5 -1 L 7 1","stroke":"#000000","strokeWidth":1},"width":6,"height":6,"color":"#000000"}}}}}' %}{% endtemplate %}

{% template trmnl_chart_scatter %}{% render "trmnl_chart", data: data, chart_type: "scatter", points: "yes" %}{% endtemplate %}

{% template trmnl_chart_stacked_column %}{% render "trmnl_chart", data: data, chart_type: "column", color_scheme: "black+grey", legend: "bottom", stacked: "yes" %}{% endtemplate %}

{% template trmnl_chart_waterfall %}{% render "trmnl_chart", data: data, modules: "yes", library: '{"chart":{"type":"waterfall"}}' %}{% endtemplate %}

{% template homey_cap_tile %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ value }}{% if unit != blank %} {{ unit }}{% endif %}</span>
    <span class="label lg:label--large">{% if icon != blank %}{% render "homey_glyph", icon: icon %}{% endif %}{{ label }}</span>
  </div>
</div>
{% endtemplate %}

{% template homey_climate %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% assign sensors = live | where: "temperature" | sort: "zone" %}
{% assign sensor_count = sensors | size %}
{% comment %} times: 1.0 first — divided_by truncates when both sides are integers {% endcomment %}
{% if sensor_count > 0 %}{% assign average = sensors | sum: "temperature" | times: 1.0 | divided_by: sensor_count | round: 1 %}{% endif %}
{% assign humid = sensors | where: "humidity" %}
{% assign humid_count = humid | size %}
{% if humid_count > 0 %}{% assign average_humidity = humid | sum: "humidity" | times: 1.0 | divided_by: humid_count | round %}{% endif %}
{% if sensor_count == 0 %}
<div class="layout">
  <div class="item">
    <div class="content content--center">
      <span class="value value--small">No temperature sensors yet</span>
      <span class="label">Readings appear once Homey has a climate device</span>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col gap--large">
  <div class="grid grid--cols-2 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        {% if sensor_count == 1 %}
          {% assign solo = sensors | first %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ solo.temperature }}&deg;</span>
          <span class="label" data-clamp="1">{{ solo.name }} &middot; {{ solo.zone }}</span>
        {% else %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ average }}&deg;</span>
          <span class="label">Average &middot; {{ sensor_count }} sensors</span>
        {% endif %}
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{% if humid_count > 0 %}{{ average_humidity }}%{% else %}&mdash;{% endif %}</span>
        <span class="label">{% if humid_count > 1 %}Average humidity{% else %}Humidity{% endif %}</span>
      </div>
    </div>
  </div>
  {% if sensor_count > 1 and sensor_count <= 4 %}
  <div class="grid grid--cols-2 gap">
    {% for sensor in sensors %}
      <div class="item">
        <div class="meta"></div>
        <div class="content">
          <span class="value value--large value--tnums">{{ sensor.temperature }}&deg;{% if sensor.humidity %} &middot; {{ sensor.humidity }}%{% endif %}</span>
          <span class="label" data-clamp="1">{{ sensor.name }} &middot; {{ sensor.zone }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
  {% elsif sensor_count > 4 %}
  <table class="table">
    <tbody>
      {% for sensor in sensors limit: 8 %}
      <tr>
        <td><span class="title title--small" data-clamp="1">{{ sensor.name }}</span></td>
        <td><span class="label">{{ sensor.zone }}</span></td>
        <td class="text--right"><span class="value value--xsmall value--tnums">{{ sensor.temperature }}&deg;</span></td>
        <td class="text--right"><span class="value value--xsmall value--tnums">{% if sensor.humidity %}{{ sensor.humidity }}%{% endif %}</span></td>
      </tr>
      {% endfor %}
      {% assign overflow = sensor_count | minus: 8 %}
      {% if overflow > 0 %}
      <tr><td colspan="4"><span class="label">+{{ overflow }} more</span></td></tr>
      {% endif %}
    </tbody>
  </table>
  {% endif %}
</div>
{% endif %}
<div class="title_bar">
  <span class="title lg:title--large">Climate</span>
  <span class="instance">{{ sensor_count }} sensors</span>
</div>
{% endtemplate %}

{% template homey_device_card %}
{% comment %} Homey localizes every capability title, so prefer the device's own label over the English fallback. {% endcomment %}
{%- comment -%} A control the owner set (dim, colour) is not a reading, so only these components tile. {%- endcomment -%}
{%- assign tiled = "sensor,battery,toggle" | split: "," -%}
<div class="flex flex--col gap--small">
  <span class="title title--small lg:title--base">{{ device.name }}</span>
  {% if device.available == false %}
    <span class="label label--outline lg:label--large">Unreachable</span>
  {% else %}
    <div class="grid grid--cols-2 gap">
      {%- if device.capabilities != blank -%}
        {%- for pair in device.capabilities -%}
          {%- assign capability = pair[1] -%}
          {%- if capability.display_value != blank and tiled contains capability.component -%}
            {% render "homey_cap_tile", label: capability.title, value: capability.display_value, unit: capability.units, icon: capability.icon %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {% if device.power != nil %}{% render "homey_cap_tile", label: device.titles.power | default: "Power", value: device.power, unit: "W" %}{% endif %}
        {% if device.temperature != nil %}{% render "homey_cap_tile", label: device.titles.temperature | default: "Temperature", value: device.temperature, unit: "°C" %}{% endif %}
        {% if device.humidity != nil %}{% render "homey_cap_tile", label: device.titles.humidity | default: "Humidity", value: device.humidity, unit: "%" %}{% endif %}
        {% if device.wind != nil %}{% render "homey_cap_tile", label: device.titles.wind | default: "Wind", value: device.wind, unit: "km/h" %}{% endif %}
        {% if device.energy != nil %}{% render "homey_cap_tile", label: device.titles.energy | default: "Energy", value: device.energy, unit: "kWh" %}{% endif %}
        {% if device.on == true %}{% render "homey_cap_tile", label: "State", value: "On", unit: "" %}{% endif %}
        {% if device.on == false %}{% render "homey_cap_tile", label: "State", value: "Off", unit: "" %}{% endif %}
      {%- endif -%}
    </div>
  {% endif %}
</div>
{% endtemplate %}

{% template homey_energy %}
{% assign show_chart = show_chart | default: "yes" %}
{% assign chart_type = chart_type | default: "column" %}
{% comment %} unique id so two instances on one screen don't collide {% endcomment %}
{% assign chart_id = "homey-energy-chart" | append_random %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% assign drawing = live | where: "power" %}
{% assign drawing_count = drawing | size %}
{% assign total_power = drawing | sum: "power" %}
{% assign top = drawing | sort: "power" | reverse | first %}
{% assign zones = drawing | map: "zone" | uniq %}
{% if drawing_count == 0 %}{% assign show_chart = "no" %}{% endif %}
{% if show_chart == "yes" %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/chartkick/5.0.1/chartkick.min.js"></script>
{% endif %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-3 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{{ total_power }}</span>
        <span class="label lg:label--large">Power now (W)</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ top.power | default: 0 }}</span>
        <span class="label lg:label--large">Top: {{ top.name | default: "None" }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xxlarge value--tnums">{{ drawing_count }} / {{ live | size }}</span>
        <span class="label lg:label--large">Drawing power</span>
      </div>
    </div>
  </div>
  {% if show_chart == "yes" %}
  <div id="{{ chart_id }}" style="width: 100%; flex-grow: 1;"></div>
  {% elsif drawing_count == 0 %}
  <div class="item">
    <div class="content content--center">
      <span class="value value--small">No power readings yet</span>
      <span class="label">Watts appear once a device reports power</span>
    </div>
  </div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title lg:title--large">Energy</span>
  <span class="instance">{{ drawing_count }} drawing power</span>
</div>
{% if show_chart == "yes" %}
<script>
  var homeyEnergyData = [
    {% for zone in zones %}
      {%- assign zone_watts = drawing | where: "zone", zone | sum: "power" -%}
      ["{{ zone }}", {{ zone_watts }}]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var createHomeyEnergyChart = function () {
    new Chartkick["{{ chart_type | capitalize }}Chart"]("{{ chart_id }}", homeyEnergyData, {
      colors: ["black"], legend: false, suffix: " W",
      library: {
        chart: { backgroundColor: "transparent" },
        plotOptions: { series: { animation: false, borderWidth: 0 } },
        yAxis: { gridLineColor: "#000", title: { text: null }, labels: { style: { color: "#000", fontSize: "18px" } } },
        xAxis: { lineColor: "#000", tickColor: "#000", labels: { style: { color: "#000", fontSize: "18px" } } },
        credits: { enabled: false }, tooltip: { enabled: false }
      }
    });
  };
  if ("Chartkick" in window) { createHomeyEnergyChart(); }
  else { window.addEventListener("chartkick:load", createHomeyEnergyChart, true); }
</script>
{% endif %}
{% endtemplate %}

{% template homey_glyph %}
<img src="/images/plugins/homey/capabilities/{{ icon }}.svg" alt="" style="width: 1em; height: 1em; vertical-align: -0.15em; margin-right: 0.25em;">
{% endtemplate %}

{% template homey_home_status %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% assign on_devices = live | where: "on", true %}
{% assign lights = live | where: "klass", "light" %}
{% assign lights_on = lights | where: "on", true %}
{% assign zones = devices | map: "zone" | uniq %}
{% assign alarm_count = 0 %}
{% for device in devices %}{% assign alarm_count = alarm_count | plus: device.alarms.size %}{% endfor %}
<div class="layout layout--col gap--large">
  <div class="grid grid--cols-2 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ on_devices | size }} / {{ live | size }}</span>
        <span class="label">Devices on</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        {% if alarm_count > 0 %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ alarm_count }}</span>
          <span class="label">Active alarms</span>
        {% else %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ lights_on | size }} / {{ lights | size }}</span>
          <span class="label">Lights on</span>
        {% endif %}
      </div>
    </div>
  </div>
  {% if alarm_count > 0 %}
    <div class="flex flex--row flex--wrap gap--small">
      {% for device in devices %}
        {% for alarm in device.alarms %}
          <span class="label label--outline">{{ device.zone }}: {{ alarm | replace: "alarm_", "" }}</span>
        {% endfor %}
      {% endfor %}
    </div>
  {% else %}
    <div class="item">
      <div class="content content--center">
        <span class="value value--small">All clear &mdash; no active alarms</span>
        <span class="label">{{ zones | size }} zones &middot; {{ lights_on | size }} of {{ lights | size }} lights on</span>
      </div>
    </div>
  {% endif %}
  <div class="hidden lg:block">
    <table class="table">
      <tbody>
        {% for device in live limit: 12 %}
        <tr>
          <td><span class="title title--small" data-clamp="1">{{ device.name }}</span></td>
          <td><span class="label">{{ device.zone }}</span></td>
          <td class="text--right"><span class="value value--xsmall value--tnums">
            {%- if device.power -%}{{ device.power }} W{% if device.on == true %} &middot; On{% endif %}
            {%- elsif device.temperature -%}{{ device.temperature }}&deg;
            {%- elsif device.on == true -%}On
            {%- elsif device.on == false -%}Off
            {%- endif -%}
          </span></td>
        </tr>
        {% endfor %}
        {% assign overflow = live | size | minus: 12 %}
        {% if overflow > 0 %}
        <tr><td colspan="3"><span class="label">+{{ overflow }} more</span></td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Home</span>
  <span class="instance">{{ live | size }} devices</span>
</div>
{% endtemplate %}

{% template homey_insights %}
{% assign point_count = series | size %}
{% comment %} unique id so two instances on one screen don't collide (prod pattern) {% endcomment %}
{% assign chart_id = "homey-insights-chart" | append_random %}
{% if point_count == 0 %}
<div class="layout">
  <div class="item">
    <div class="content content--center">
      <span class="value value--small">No insight data yet</span>
      <span class="label">Pick a logged metric in plugin settings</span>
    </div>
  </div>
</div>
{% else %}
{% assign latest_pair = series | last %}
{% assign latest = latest_pair[1] %}
{% assign low = latest %}
{% assign high = latest %}
{% for pair in series %}
  {% if pair[1] != nil %}
    {% if pair[1] < low %}{% assign low = pair[1] %}{% endif %}
    {% if pair[1] > high %}{% assign high = pair[1] %}{% endif %}
  {% endif %}
{% endfor %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/chartkick/5.0.1/chartkick.min.js"></script>
<div class="layout layout--col gap">
  <div class="grid grid--cols-2 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ latest | round: 1 }}{{ unit }}</span>
        <span class="label" data-clamp="1">{{ title | default: "Insights" }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large value--tnums" data-fit-value="true">{{ low | round: 1 }}&ndash;{{ high | round: 1 }}{{ unit }}</span>
        <span class="label">24h range</span>
      </div>
    </div>
  </div>
  <div id="{{ chart_id }}" style="width: 100%; flex-grow: 1;"></div>
</div>
<script>
  var homeyInsightsData = {{ series | json }};
  var createHomeyInsightsChart = function () {
    new Chartkick["LineChart"]("{{ chart_id }}", homeyInsightsData, {
      colors: ["black"], legend: false, points: false, curve: true,
      library: {
        chart: { backgroundColor: "transparent" },
        plotOptions: { series: { animation: false, lineWidth: 4 } },
        yAxis: { gridLineColor: "#000", gridLineDashStyle: "dot", title: { text: null }, labels: { style: { color: "#000", fontSize: "14px" } } },
        xAxis: { type: "datetime", lineColor: "#000", tickColor: "#000", labels: { style: { color: "#000", fontSize: "14px" } } },
        credits: { enabled: false }, tooltip: { enabled: false }
      }
    });
  };
  if ("Chartkick" in window) { createHomeyInsightsChart(); }
  else { window.addEventListener("chartkick:load", createHomeyInsightsChart, true); }
</script>
{% endif %}
<div class="title_bar">
  <span class="title lg:title--large">Insights</span>
  <span class="instance">{{ title | default: "Last 24 hours" }}</span>
</div>
{% endtemplate %}

{% template homey_overview %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% comment %} times: 1.0 first — divided_by truncates when both operands are integers {% endcomment %}
{% assign sensors = live | where: "temperature" %}
{% assign sensor_count = sensors | size %}
{% if sensor_count > 0 %}{% assign avg_temp = sensors | sum: "temperature" | times: 1.0 | divided_by: sensor_count | round: 1 %}{% endif %}
{% assign humidity_sensors = live | where: "humidity" %}
{% assign humidity_count = humidity_sensors | size %}
{% if humidity_count > 0 %}{% assign avg_humidity = humidity_sensors | sum: "humidity" | times: 1.0 | divided_by: humidity_count | round %}{% endif %}
{% assign devices_with_power = live | where: "power" %}
{% assign total_power = devices_with_power | sum: "power" %}
{% assign zones = devices | map: "zone" | uniq %}
{% assign zone_count = zones | size %}
{% assign device_count = live | size %}
<div class="layout layout--col gap--large">
  <div class="grid grid--cols-3 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{% if sensor_count > 0 %}{{ avg_temp }}&deg;{% else %}&mdash;{% endif %}</span>
        <span class="label lg:label--large">{% render "homey_glyph", icon: "measure-temperature" %}Avg temp</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{% if humidity_count > 0 %}{{ avg_humidity }}%{% else %}&mdash;{% endif %}</span>
        <span class="label lg:label--large">{% render "homey_glyph", icon: "measure-humidity" %}Humidity</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{{ total_power }}</span>
        <span class="label lg:label--large">{% render "homey_glyph", icon: "measure-power" %}Watts now</span>
      </div>
    </div>
  </div>
  <table class="table">
    <tbody>
      {% for device in live limit: 8 %}
      {% comment %} Homey raises alarm_battery at its own threshold, so a panel never guesses one. {% endcomment %}
      {% assign battery = device.capabilities.measure_battery %}
      {% assign battery_low = device.capabilities.alarm_battery %}
      <tr>
        <td><span class="title title--small" data-clamp="1">{{ device.name }}</span></td>
        <td><span class="label">{{ device.zone }}</span></td>
        <td class="text--right"><span class="value value--xsmall value--tnums">
          {%- if device.capabilities != blank -%}
            {%- for pair in device.capabilities -%}
              {%- assign capability = pair[1] -%}
              {%- if capability.component == "sensor" and capability.display_value != blank -%}
                {% render "homey_glyph", icon: capability.icon %}{{ capability.display_value }}{{ capability.units }}&nbsp;&nbsp;
              {%- endif -%}
            {%- endfor -%}
          {%- else -%}
            {%- if device.temperature -%}{{ device.temperature }}&deg;{% if device.humidity %} &middot; {{ device.humidity }}%{% endif %}
            {%- elsif device.power -%}{{ device.power }} W{% if device.on == true %} &middot; On{% endif %}
            {%- elsif device.on == true -%}On
            {%- elsif device.on == false -%}Off
            {%- endif -%}
          {%- endif -%}
        </span></td>
        <td class="text--right">
          {%- if battery != blank -%}
          <span class="label{% if battery_low.value == true %} label--error{% endif %}">{% render "homey_glyph", icon: "measure-battery" %}{{ battery.display_value }}%</span>
          {%- endif -%}
        </td>
      </tr>
      {% endfor %}
      {% assign overflow = live | size | minus: 8 %}
      {% if overflow > 0 %}
      <tr><td colspan="4"><span class="label">+{{ overflow }} more</span></td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Home</span>
  <span class="instance">{{ zone_count }} zone{% if zone_count != 1 %}s{% endif %} &middot; {{ device_count }} device{% if device_count != 1 %}s{% endif %}</span>
</div>
{% endtemplate %}

{% template homey_solar %}
{% comment %} Nothing marks a device as an inverter, so match names the producing device(s); without it this totals every meter in the home. {% endcomment %}
{% if match %}{% assign pool = devices | where_exp: "device", "device.name contains match" %}{% else %}{% assign pool = devices %}{% endif %}
{% assign pool = pool | where_exp: "device", "device.available != false" %}
{% assign metered = pool | where: "energy" %}
{% assign producing = pool | where: "power" %}
{% assign current_power = producing | sum: "power" %}
{% assign total = metered | sum: "energy" %}
<div class="layout layout--col gap">
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--xxlarge lg:value--giga value--tnums" data-fit-value="true">{{ current_power }} W</span>
      <span class="label lg:label--large">Producing now</span>
    </div>
  </div>
  <div class="grid grid--cols-2 gap">
    {% render "homey_cap_tile", label: "Energy total", value: total, unit: "kWh" %}
    {% render "homey_cap_tile", label: "Meters", value: metered.size, unit: "" %}
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Solar</span>
  <span class="instance">{{ producing | size }} producing</span>
</div>
{% endtemplate %}

{% template homey_weather %}
{% comment %} The snapshot has no indoor/outdoor flag, so which sensor is "outside" is the user's call — match filters devices by name. {% endcomment %}
{% if match %}{% assign pool = devices | where_exp: "device", "device.name contains match" %}{% else %}{% assign pool = devices %}{% endif %}
{% assign pool = pool | where_exp: "device", "device.available != false" %}
{% assign temps = pool | where: "temperature" %}
{% assign humidities = pool | where: "humidity" %}
{% assign winds = pool | where: "wind" %}
{% assign columns = columns | default: "3" %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-{{ columns }} lg:grid--cols-3 gap">
    {% if temps != empty %}{% render "homey_cap_tile", label: temps.first.name, value: temps.first.temperature, unit: "°C" %}{% endif %}
    {% if humidities != empty %}{% render "homey_cap_tile", label: "Humidity", value: humidities.first.humidity, unit: "%" %}{% endif %}
    {% if winds != empty %}{% render "homey_cap_tile", label: "Wind", value: winds.first.wind, unit: "km/h" %}{% endif %}
  </div>
  <div class="grid grid--cols-2 lg:grid--cols-4 gap">
    {% for sensor in temps offset: 1 %}
      {% render "homey_cap_tile", label: sensor.zone, value: sensor.temperature, unit: "°C" %}
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Weather</span>
  <span class="instance">{{ temps | size }} sensors</span>
</div>
{% endtemplate %}

{% template homey_zone_section %}
{% assign in_zone = devices | where: "zone", zone %}
<div class="layout layout--col gap">
  <span class="title lg:title--large">{{ zone }}</span>
  <div class="grid grid--cols-2 gap">
    {% for device in in_zone %}
      {% render "homey_device_card", device: device %}
    {% endfor %}
  </div>
</div>
{% endtemplate %}

