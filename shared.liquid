{% template homey_cap_tile %}
<div class="item">
  <div class="meta"></div>
  <div class="content">
    <span class="value value--large value--tnums" data-fit-value="true">{{ value }}{% if unit != "" %} {{ unit }}{% endif %}</span>
    <span class="label">{{ label }}</span>
  </div>
</div>
{% endtemplate %}

{% template homey_climate_home %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-2 gap">
    {% render "homey_cap_tile", label: "Avg temperature", value: climate.avg_temp.value, unit: climate.avg_temp.unit %}
    {% render "homey_cap_tile", label: "Devices on", value: home.devices_on, unit: "" %}
  </div>
  <div class="grid grid--cols-2 gap">
    {% for sensor in climate.sensors %}
      {% render "homey_cap_tile", label: sensor.name, value: sensor.value, unit: sensor.unit %}
    {% endfor %}
  </div>
  {% if home.alarms.size > 0 %}
    <div class="flex flex--row flex--wrap gap--small">
      {% for alarm in home.alarms %}
        <span class="label label--outline">{{ alarm.zone }}: {{ alarm.type }}</span>
      {% endfor %}
    </div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">Home</span>
  <span class="instance">Climate</span>
</div>
{% endtemplate %}

{% template homey_device_card %}
<div class="flex flex--col gap--small">
  <span class="title title--small">{{ device.name }}</span>
  <div class="grid grid--cols-2 gap">
    {% for cap in device.capabilities %}
      {% render "homey_cap_tile", label: cap.title, value: cap.value, unit: cap.unit %}
    {% endfor %}
  </div>
</div>
{% endtemplate %}

{% template homey_energy %}
{% assign show_chart = show_chart | default: "yes" %}
{% assign chart_type = chart_type | default: "column" %}
{% comment %} unique id so two instances on one screen don't collide (prod pattern) {% endcomment %}
{% assign chart_id = "homey-energy-chart" | append_random %}
{% if show_chart == "yes" %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/chartkick/5.0.1/chartkick.min.js"></script>
{% endif %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-3 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge value--tnums" data-fit-value="true">{{ energy.total_power.value }}</span>
        <span class="label">Power now ({{ energy.total_power.unit }})</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large value--tnums" data-fit-value="true">{{ energy.top_consumer.value }}</span>
        <span class="label">Top: {{ energy.top_consumer.name }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large value--tnums">{{ energy.by_zone | size }}</span>
        <span class="label">Zones</span>
      </div>
    </div>
  </div>
  {% if show_chart == "yes" %}
  <div id="{{ chart_id }}" style="width: 100%; flex-grow: 1;"></div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title">Energy</span>
  <span class="instance">Home</span>
</div>
{% if show_chart == "yes" %}
<script>
  var homeyEnergyData = [
    {% for zone in energy.by_zone %}["{{ zone.zone }}", {{ zone.value }}]{% unless forloop.last %},{% endunless %}{% endfor %}
  ];
  var createHomeyEnergyChart = function () {
    new Chartkick["{{ chart_type | capitalize }}Chart"]("{{ chart_id }}", homeyEnergyData, {
      colors: ["black"], legend: false, suffix: " W",
      library: {
        chart: { backgroundColor: "transparent" },
        plotOptions: { series: { animation: false, borderWidth: 0 } },
        yAxis: { gridLineColor: "#000", gridLineDashStyle: "dot", title: { text: null }, labels: { style: { color: "#000", fontSize: "14px" } } },
        xAxis: { lineColor: "#000", tickColor: "#000", labels: { style: { color: "#000", fontSize: "14px" } } },
        credits: { enabled: false }, tooltip: { enabled: false }
      }
    });
  };
  if ("Chartkick" in window) { createHomeyEnergyChart(); }
  else { window.addEventListener("chartkick:load", createHomeyEnergyChart, true); }
</script>
{% endif %}
{% endtemplate %}

