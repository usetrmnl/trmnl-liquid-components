{%- comment -%} Single-glance summary for the half and quadrant slots — one hero stat fits any small dimension. Paste into markup_half_horizontal / markup_half_vertical / markup_quadrant. {%- endcomment -%}
{%- assign homey_data = homey.merge_variables | default: homey -%}
{%- assign devices = homey_data.devices -%}
{% if devices == blank %}
  <div class="layout layout--col gap flex flex--center">
    <span class="label label--gray">Waiting for the first push…</span>
  </div>
  <div class="title_bar">
    <span class="title">Homey</span>
    <span class="instance">Not connected</span>
  </div>
{% else %}
  {%- assign live = devices | where_exp: "device", "device.available != false" -%}
  {%- assign on_devices = live | where: "on", true -%}
  {%- assign devices_with_power = live | where: "power" -%}
  {%- assign total_power = 0 -%}{% for device in devices_with_power %}{% assign total_power = total_power | plus: device.power %}{% endfor %}
  <div class="layout layout--col flex flex--center">
    <span class="value value--xxlarge lg:value--giga value--tnums" data-fit-value="true">{{ on_devices | size }} / {{ live | size }}</span>
    <span class="label lg:label--large">Devices on{% if total_power > 0 %} &middot; {{ total_power }} W{% endif %}</span>
  </div>
  <div class="title_bar">
    <span class="title">Homey</span>
    <span class="instance">{{ live | size }} devices</span>
  </div>
{% endif %}
