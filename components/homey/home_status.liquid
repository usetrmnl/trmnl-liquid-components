{% template homey_home_status %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% assign on_devices = live | where: "on", true %}
{% assign lights = live | where: "klass", "light" %}
{% assign lights_on = lights | where: "on", true %}
{% assign zones = devices | map: "zone" | uniq %}
{% assign alarm_count = 0 %}
{% for device in devices %}{% assign alarm_count = alarm_count | plus: device.alarms.size %}{% endfor %}
<div class="layout layout--col gap--large">
  <div class="grid grid--cols-2 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ on_devices | size }} / {{ live | size }}</span>
        <span class="label">{% render "homey_glyph", icon: "onoff" %}Devices on</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        {% if alarm_count > 0 %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ alarm_count }}</span>
          <span class="label">{% render "homey_glyph", icon: "alarm-generic-active" %}Active alarms</span>
        {% else %}
          <span class="value value--xlarge lg:value--xxlarge value--tnums" data-fit-value="true">{{ lights_on | size }} / {{ lights | size }}</span>
          <span class="label">{% render "homey_glyph", icon: "light-hue" %}Lights on</span>
        {% endif %}
      </div>
    </div>
  </div>
  {% if alarm_count > 0 %}
    <div class="flex flex--row flex--wrap gap--small">
      {% for device in devices %}
        {% for alarm in device.alarms %}
          {%- assign alarm_icon = alarm | replace: "_", "-" | append: "-active" -%}
          <span class="label label--outline">{% render "homey_glyph", icon: alarm_icon %}{{ device.zone }}: {{ alarm | replace: "alarm_", "" }}</span>
        {% endfor %}
      {% endfor %}
    </div>
  {% else %}
    <div class="item">
      <div class="content content--center">
        <span class="value value--small">All clear &mdash; no active alarms</span>
        <span class="label">{{ zones | size }} zones &middot; {{ lights_on | size }} of {{ lights | size }} lights on</span>
      </div>
    </div>
  {% endif %}
  <div class="hidden lg:block w--full">
    <table class="table">
      <tbody>
        {% for device in live limit: 12 %}
        <tr>
          <td><span class="title title--small" data-clamp="1">{{ device.name }}</span></td>
          <td><span class="label">{{ device.zone }}</span></td>
          <td class="text--right"><span class="value value--xsmall value--tnums">
            {%- if device.power -%}{{ device.power }} W{% if device.on == true %} &middot; On{% endif %}
            {%- elsif device.temperature -%}{{ device.temperature }}&deg;
            {%- elsif device.on == true -%}On
            {%- elsif device.on == false -%}Off
            {%- endif -%}
          </span></td>
          <td class="text--right">{% assign battery = device.capabilities.measure_battery %}{% if battery != blank %}<span class="label{% if device.capabilities.alarm_battery.value == true %} label--error{% endif %}">{% render "homey_glyph", icon: "measure-battery" %}{{ battery.display_value }}%</span>{% endif %}</td>
        </tr>
        {% endfor %}
        {% assign overflow = live | size | minus: 12 %}
        {% if overflow > 0 %}
        <tr><td colspan="4"><span class="label">+{{ overflow }} more</span></td></tr>
        {% endif %}
      </tbody>
    </table>
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Home</span>
  <span class="instance">{{ live | size }} devices</span>
</div>
{% endtemplate %}
