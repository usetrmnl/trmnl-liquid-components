{% template homey_energy %}
{% assign show_chart = show_chart | default: "yes" %}
{% assign chart_type = chart_type | default: "column" %}
{% comment %} unique id so two instances on one screen don't collide (prod pattern) {% endcomment %}
{% assign chart_id = "homey-energy-chart" | append_random %}
{% comment %} Aggregates the snapshot's flat device list — Liquid can't build an array, so totals are summed where they're rendered. {% endcomment %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% assign drawing = live | where: "power" %}
{% assign total_power = 0 %}
{% for device in drawing %}{% assign total_power = total_power | plus: device.power %}{% endfor %}
{% assign ranked = drawing | sort: "power" | reverse %}
{% assign top = ranked | first %}
{% assign zones = drawing | map: "zone" | uniq %}
{% if show_chart == "yes" %}
<script src="https://trmnl.com/js/highcharts/12.3.0/highcharts.js"></script>
<script src="https://trmnl.com/js/chartkick/5.0.1/chartkick.min.js"></script>
{% endif %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-3 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{{ total_power }}</span>
        <span class="label lg:label--large">Power now (W)</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xxlarge value--tnums" data-fit-value="true">{{ top.power | default: 0 }}</span>
        <span class="label lg:label--large">Top: {{ top.name | default: "None" }}</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--large lg:value--xxlarge value--tnums">{{ zones | size }}</span>
        <span class="label lg:label--large">Zones</span>
      </div>
    </div>
  </div>
  {% if show_chart == "yes" %}
  <div id="{{ chart_id }}" style="width: 100%; flex-grow: 1;"></div>
  {% endif %}
</div>
<div class="title_bar">
  <span class="title lg:title--large">Energy</span>
  <span class="instance">{{ drawing | size }} drawing power</span>
</div>
{% if show_chart == "yes" %}
<script>
  var homeyEnergyData = [
    {% for zone in zones %}
      {%- assign in_zone = drawing | where: "zone", zone -%}
      {%- assign zone_watts = 0 -%}
      {%- for device in in_zone %}{% assign zone_watts = zone_watts | plus: device.power %}{% endfor -%}
      ["{{ zone }}", {{ zone_watts }}]{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];
  var createHomeyEnergyChart = function () {
    new Chartkick["{{ chart_type | capitalize }}Chart"]("{{ chart_id }}", homeyEnergyData, {
      colors: ["black"], legend: false, suffix: " W",
      library: {
        chart: { backgroundColor: "transparent" },
        plotOptions: { series: { animation: false, borderWidth: 0 } },
        yAxis: { gridLineColor: "#000", gridLineDashStyle: "dot", title: { text: null }, labels: { style: { color: "#000", fontSize: "14px" } } },
        xAxis: { lineColor: "#000", tickColor: "#000", labels: { style: { color: "#000", fontSize: "14px" } } },
        credits: { enabled: false }, tooltip: { enabled: false }
      }
    });
  };
  if ("Chartkick" in window) { createHomeyEnergyChart(); }
  else { window.addEventListener("chartkick:load", createHomeyEnergyChart, true); }
</script>
{% endif %}
{% endtemplate %}
