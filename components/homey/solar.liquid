{% template homey_solar %}
<div class="layout layout--col gap">
  <div class="item">
    <div class="meta"></div>
    <div class="content">
      <span class="value value--xxlarge lg:value--giga value--tnums" data-fit-value="true">{{ solar.now.value }} {{ solar.now.unit }}</span>
      <span class="label lg:label--large">Producing now</span>
    </div>
  </div>
  <div class="grid grid--cols-2 gap">
    {% render "homey_cap_tile", label: "Today", value: solar.today.value, unit: solar.today.unit %}
    {% render "homey_cap_tile", label: "Grid feed-in", value: solar.feed_in.value, unit: solar.feed_in.unit %}
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Solar</span>
  <span class="instance">Production</span>
</div>
{% endtemplate %}
