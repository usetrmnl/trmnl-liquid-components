{% template homey_weather %}
{% comment %} The snapshot has no indoor/outdoor flag, so which sensor is "outside" is the user's call — match filters devices by name. {% endcomment %}
{% if match %}{% assign pool = devices | where_exp: "device", "device.name contains match" %}{% else %}{% assign pool = devices %}{% endif %}
{% assign pool = pool | where_exp: "device", "device.available != false" %}
{% assign temps = pool | where: "temperature" %}
{% assign humidities = pool | where: "humidity" %}
{% assign winds = pool | where: "wind" %}
{% assign columns = columns | default: "3" %}
<div class="layout layout--col gap">
  <div class="grid grid--cols-{{ columns }} lg:grid--cols-3 gap">
    {% if temps != empty %}{% render "homey_cap_tile", label: temps.first.name, value: temps.first.temperature, unit: "°C" %}{% endif %}
    {% if humidities != empty %}{% render "homey_cap_tile", label: "Humidity", value: humidities.first.humidity, unit: "%" %}{% endif %}
    {% if winds != empty %}{% render "homey_cap_tile", label: "Wind", value: winds.first.wind, unit: "km/h" %}{% endif %}
  </div>
  <div class="grid grid--cols-2 lg:grid--cols-4 gap">
    {% for sensor in temps offset: 1 %}
      {% render "homey_cap_tile", label: sensor.zone, value: sensor.temperature, unit: "°C" %}
    {% endfor %}
  </div>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Weather</span>
  <span class="instance">{{ temps | size }} sensors</span>
</div>
{% endtemplate %}
