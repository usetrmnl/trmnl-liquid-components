{% template homey_overview %}
{% assign live = devices | where_exp: "device", "device.available != false" %}
{% comment %} times: 1.0 first — divided_by truncates when both operands are integers {% endcomment %}
{% assign sensors = live | where: "temperature" %}
{% assign sensor_count = sensors | size %}
{% if sensor_count > 0 %}{% assign avg_temp = sensors | sum: "temperature" | times: 1.0 | divided_by: sensor_count | round: 1 %}{% endif %}
{% assign humidity_sensors = live | where: "humidity" %}
{% assign humidity_count = humidity_sensors | size %}
{% if humidity_count > 0 %}{% assign avg_humidity = humidity_sensors | sum: "humidity" | times: 1.0 | divided_by: humidity_count | round %}{% endif %}
{% assign devices_with_power = live | where: "power" %}
{% assign total_power = devices_with_power | sum: "power" %}
{% assign zones = devices | map: "zone" | uniq %}
<div class="layout layout--col gap--large">
  <div class="grid grid--cols-3 gap">
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{% if sensor_count > 0 %}{{ avg_temp }}&deg;{% else %}&mdash;{% endif %}</span>
        <span class="label lg:label--large">Avg temp</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{% if humidity_count > 0 %}{{ avg_humidity }}%{% else %}&mdash;{% endif %}</span>
        <span class="label lg:label--large">Humidity</span>
      </div>
    </div>
    <div class="item">
      <div class="meta"></div>
      <div class="content">
        <span class="value value--xlarge lg:value--giga value--tnums" data-fit-value="true">{{ total_power }}</span>
        <span class="label lg:label--large">Watts now</span>
      </div>
    </div>
  </div>
  <table class="table">
    <tbody>
      {% for device in live limit: 8 %}
      <tr>
        <td><span class="title title--small" data-clamp="1">{{ device.name }}</span></td>
        <td><span class="label">{{ device.zone }}</span></td>
        <td class="text--right"><span class="value value--xsmall value--tnums">
          {%- if device.temperature -%}{{ device.temperature }}&deg;{% if device.humidity %} &middot; {{ device.humidity }}%{% endif %}
          {%- elsif device.power -%}{{ device.power }} W{% if device.on == true %} &middot; On{% endif %}
          {%- elsif device.on == true -%}On
          {%- elsif device.on == false -%}Off
          {%- endif -%}
        </span></td>
      </tr>
      {% endfor %}
      {% assign overflow = live | size | minus: 8 %}
      {% if overflow > 0 %}
      <tr><td colspan="3"><span class="label">+{{ overflow }} more</span></td></tr>
      {% endif %}
    </tbody>
  </table>
</div>
<div class="title_bar">
  <span class="title lg:title--large">Home</span>
  <span class="instance">{{ zones | size }} zones &middot; {{ live | size }} devices</span>
</div>
{% endtemplate %}
