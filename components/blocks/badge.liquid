{% template trmnl_badge %}
{% assign size = size | default: "base" %}
{% assign default_style = default_style | default: "outline" %}
<div class="flex flex--row flex--wrap gap--small">
  {% for b in badges %}
  <span class="label label--{{ b.style | default: default_style }}{% if size == 'small' %} label--small{% elsif size == 'large' %} label--large{% endif %}">{{ b.text }}</span>
  {% endfor %}
</div>
{% endtemplate %}
